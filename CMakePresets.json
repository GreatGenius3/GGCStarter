{
  "version": 3,
  "configurePresets": [
    {
      "name": "Mingw GCC",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "displayName": "GCC: Debug",
      "inherits": "Mingw GCC",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "GCC: Release",
      "inherits": "Mingw GCC",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}
